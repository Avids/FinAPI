# Turso. For local dev you can use a file DB: TURSO_DATABASE_URL=file:local.db (no token needed)
TURSO_DATABASE_URL=libsql://secapi-<your-org>.turso.io
TURSO_AUTH_TOKEN=

# REQUIRED by SEC: identify yourself with app name + contact email, otherwise SEC returns 403
SEC_USER_AGENT="SECAPI yourname@example.com"

# Shared secret for /api/cron/refresh (also set as a GitHub Actions secret)
CRON_SECRET=change-me

# Optional: if set, every /api/financials request must send header `x-api-key: <value>`
API_KEY=

# Optional: CORS allow-origin (default *)
ALLOWED_ORIGIN=*
